# Default backend uses an already installed and authenticated Codex CLI.
CONTINUITY_PROVIDER=codex
CODEX_COMMAND=codex
CODEX_MODEL=
CONTINUITY_TIMEOUT_SECONDS=600

# Optional OpenAI-compatible vision API: install .[api] first.
# CONTINUITY_PROVIDER=openai-compatible
# VISION_API_KEY=
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=
